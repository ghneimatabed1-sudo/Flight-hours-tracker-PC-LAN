# Internal Postgres for LAN operation
DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5432/hawkeye_internal

# Enforce LAN session token on /api/internal/* data routes
HAWK_INTERNAL_SESSION_AUTH=required

# First admin bootstrap token (required for initial setup on empty DB)
HAWK_LAN_BOOTSTRAP_TOKEN=change-this-bootstrap-token

# DEV ONLY: keep disabled in production
HAWK_LAN_DEV_NO_AUTH=0
